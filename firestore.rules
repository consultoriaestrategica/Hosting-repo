rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Resolución de rol por UID (no por email: las rules no pueden
    // hacer queries "where email == ...", solo pueden leer un
    // documento por su path exacto). user_roles/{uid} se mantiene
    // sincronizado por scripts/migrate-user-roles.js y por
    // addFamilyMember() en src/hooks/use-family-members.ts.
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function hasRoleDoc() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/user_roles/$(request.auth.uid));
    }

    function myRole() {
      return get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data;
    }

    // Cualquiera de los 4 roles de personal (Administrador, Supervisor,
    // Líder de Enfermería, Personal de Cuidado).
    function isStaff() {
      return hasRoleDoc() && myRole().kind == 'staff';
    }

    function isAdmin() {
      return isStaff() && myRole().role == 'Administrador';
    }

    function isFamily() {
      return hasRoleDoc() && myRole().kind == 'family';
    }

    // El familiar solo puede tocar el residente que tiene asignado
    // (user_roles.residentId). Usamos igualdad simple (no "in" contra
    // una lista) a propósito: Firestore solo puede validar de forma
    // confiable, dentro de una QUERY con where(residentId == X), una
    // comparación de igualdad — no una pertenencia a una lista
    // obtenida con get(). Si en el futuro un familiar necesita ver
    // más de un residente, esto requiere rediseñar el modelo de datos.
    function isFamilyOfResident(residentId) {
      return isFamily() && residentId == myRole().residentId;
    }

    function isMyFamilyDoc(familyDocId) {
      return isFamily() && familyDocId == myRole().familyDocId;
    }

    // ============================================================
    // COLECCIÓN: user_roles
    // Cada usuario solo puede LEER su propio documento de rol.
    // La escritura NUNCA la hace el propio usuario (evita que
    // alguien se auto-asigne un rol/residentId): la crea el Admin
    // SDK (scripts/migrate-user-roles.js) o un Administrador ya
    // autenticado, que es quien realmente ejecuta addFamilyMember()
    // en src/hooks/use-family-members.ts (el nuevo familiar se crea
    // en una instancia de Auth secundaria; quien escribe en
    // Firestore sigue siendo el admin de la sesión principal).
    // ============================================================
    match /user_roles/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ============================================================
    // COLECCIÓN: staff
    // Ficha de personal. Cualquier miembro de staff puede leer el
    // directorio (igual que hoy); solo Administrador puede
    // crear/editar/borrar personal.
    // ============================================================
    match /staff/{staffId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // COLECCIÓN: family_members
    // Staff ve el listado completo (gestión de familiares).
    // Un familiar solo puede leer SU PROPIO documento (el que
    // generó su user_roles.familyDocIds), nunca el listado completo
    // ni el de otro familiar. Solo Administrador gestiona altas/
    // bajas de familiares (coincide con RouteGuard permission=
    // "settings" en dashboard/settings/page.tsx, que envuelve el
    // componente de gestión de familiares).
    // ============================================================
    match /family_members/{familyId} {
      allow read: if isStaff() || isMyFamilyDoc(familyId);
      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // COLECCIÓN: residents
    // Cualquier miembro de staff mantiene el mismo acceso de
    // lectura/escritura que tiene hoy. Un familiar SOLO puede leer
    // el/los residente(s) que tiene asignado(s) — nunca la colección
    // completa ni el de otro residente, y nunca puede escribir.
    // ============================================================
    match /residents/{residentId} {
      allow read: if isStaff() || isFamilyOfResident(residentId);
      allow write: if isStaff();
    }

    // ============================================================
    // COLECCIÓN: dailyLogs
    // Igual criterio que residents: staff mantiene su acceso actual;
    // un familiar solo lee los registros de su residente asignado.
    // ============================================================
    match /dailyLogs/{logId} {
      allow read: if isStaff() ||
        (isFamily() && resource.data.residentId == myRole().residentId);
      allow create, update, delete: if isStaff();
    }

    // ============================================================
    // COLECCIÓN: logs (legacy, mismo criterio que dailyLogs)
    // ============================================================
    match /logs/{logId} {
      allow read: if isStaff() ||
        (isFamily() && resource.data.residentId == myRole().residentId);
      allow create, update, delete: if isStaff();
    }

    // ============================================================
    // COLECCIÓN: resident_contracts
    // Staff mantiene su acceso actual; familiar solo lee el
    // contrato de su residente asignado.
    // ============================================================
    match /resident_contracts/{contractId} {
      allow read: if isStaff() ||
        (isFamily() && resource.data.residentId == myRole().residentId);
      allow write: if isStaff();
    }

    // ============================================================
    // COLECCIÓN: staff_contracts
    // Dato de personal, nunca visible para familiares.
    // ============================================================
    match /staff_contracts/{contractId} {
      allow read, write: if isStaff();
    }

    // ============================================================
    // COLECCIÓN: settings
    // Lectura: cualquier staff (config general de la app).
    // Escritura: solo Administrador (coincide con RouteGuard
    // permission="settings" en dashboard/settings/page.tsx).
    // ============================================================
    match /settings/{settingId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ============================================================
    // COLECCIÓN: users (legacy, no se usa como fuente de datos real
    // en ningún hook actual; se deja bloqueada por seguridad).
    // ============================================================
    match /users/{userId} {
      allow read, write: if isAdmin();
    }

    // REGLA POR DEFECTO: DENEGAR TODO LO DEMÁS
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
